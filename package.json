    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "7.10.0",
    "smtp-server": "^3.19.16",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
