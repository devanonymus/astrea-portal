# Required. Values must be supplied privately in the deployment environment.
DATABASE_URL=
# Optional local fallback when Railway's public address is used outside its network.
DATABASE_PUBLIC_URL=
APP_URL=

# Google OAuth web client; callback: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional mail: verification, recovery and professional invitations
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private S3-compatible object storage (bucket must not be public)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Public institutional address, displayed on contact and privacy pages
CONTACT_EMAIL=
